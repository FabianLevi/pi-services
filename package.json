{
  "name": "pi-services",
  "version": "0.1.0",
  "description": "Pi extension: per-project service definitions with background execution and live log access for the agent.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "fabian@nblock.ai",
  "packageManager": "pnpm@11.1.1",
  "files": [
    "extensions",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./extensions"]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
