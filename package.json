    "prepublishOnly": "pnpm test && node scripts/verify-package-files.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "^1.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
